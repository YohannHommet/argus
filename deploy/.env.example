# Argus — local/self-hosted stack configuration.
#
# Copy this file to deploy/.env (gitignored, never committed — `make setup`
# does this for you) and edit it. `docker compose -f deploy/docker-compose.yml`
# auto-loads deploy/.env because Compose's project directory defaults to the
# directory of the compose file, so no --env-file flag is needed.
#
# This is only the subset of knobs a self-hoster actually changes day to day.
# The full ARGUS_* surface argusd reads (every env var, every default) is
# generated from the config struct into docs/config-reference.md — anything
# not listed here falls back to argusd's own built-in default unchanged.

# Host port the UI + API + ingest listener is published on (the container
# always listens on :8080 internally, regardless of this value). `make up` /
# `make setup` read this back out of deploy/.env, so it's the one place to
# change it once you've picked one — no need to also pass PORT= by hand.
ARGUS_HTTP_PORT=8080

# Days of raw events/metric_samples kept before the daily retention job drops
# their monthly partition. Must be positive (0 is rejected, not "keep forever").
ARGUS_RETENTION_RAW_DAYS=90

# How often the rollup worker aggregates raw events into rollup_hourly/daily.
ARGUS_ROLLUP_INTERVAL=60s

# Bearer token OTLP/hook ingest requests must present (Authorization: Bearer
# <token>). Empty = no auth — fine while Argus is only reachable from
# localhost; set a real value before exposing it beyond your own machine.
ARGUS_INGEST_TOKEN=

# Bearer token the read API (session/analytics endpoints the UI calls) must
# present. Empty = no auth. Same localhost caveat as ARGUS_INGEST_TOKEN.
ARGUS_API_TOKEN=

# slog level: debug, info, warn, or error.
ARGUS_LOG_LEVEL=info
