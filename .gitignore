# Go
/bin/
/server/bin/
/server/argusd
/server/argus-sim
*.test
*.out
cover.out

# Node
node_modules/
web/dist/
web/coverage/
.pnpm-store/
pnpm-debug.log*
npm-debug.log*

# Build output.
# Deliberately NOT a bare `dist/`: the embedded-SPA target
# server/internal/httpapi/assets/dist must keep a committed placeholder so
# `go:embed` compiles without a prior web build (SPEC §8.1). web/dist is
# already ignored above.
/dist/

# Screenshot harness output (scripts/ui-capture.sh takes the out dir as $1;
# these are the conventional locations, and PNGs are never committed).
/screenshots/
/web/screenshots/

# Playwright E2E output (scripts/e2e.sh / web/playwright.config.ts) — the HTML
# report, traces, and per-run artifacts are never committed.
/web/playwright-report/
/web/test-results/
/web/.playwright/

# Env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
*.swp
*.swo
.idea/
.vscode/
.worktrees/

# local machine config (host port etc.)
deploy/.env
.env
